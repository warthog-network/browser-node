# deps / build
node_modules/
dist/
.astro/
.netlify/
.extension-package/

# Built extension download (regenerate with npm run extension:package)
public/downloads/*.zip

# Multi‑GB chain snapshot (link via scripts/link-public-snapshot.mjs).
# Manifest JSON is committed; the .db3 must not be force-added or Netlify-deployed.
public/snapshot/chain.db3
public/snapshot/*.db3
public/snapshot/*.db3-*

# env / OS
.env
.env.*
!.env.example

# Private pool-threshold share (home signer). Never ship in the public zip.
signer-share.local.json
signer-share-phone.local.json
extension/signer-share.json
.DS_Store
*.log
npm-debug.log*

# editor
.idea/
.vscode/
*.swp
